function timeJump() {
  const seq = [
    { mode: "A", delay:   0 },
    { mode: "B", delay: 120 },
    { mode: "AN", delay: 260 },
    { mode: "E", delay: 420 },
    { mode: "Z", delay: 620 },
    { mode: "A", delay: 900 }
  ];

  seq.forEach(step => {
    setTimeout(() => {
      currentMode = step.mode;
      renderUI();
    }, step.delay);
  });
}

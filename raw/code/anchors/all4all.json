function renderAN(target, data) {
  target.innerHTML = `
    <div style="padding:10px; border:1px solid #0ff; color:#0ff; font-family:monospace;">
      <div><b>AXIS:</b> ${data.meta.axis}</div>
      <div><b>LAYER:</b> ${data.meta.layer}</div>
      <div><b>LANG:</b> ${data.meta.language}</div>
      <div><b>BEAM:</b> ${data.meta.beam_type}</div>
      <pre style="font-size:12px; margin-top:6px;">
${JSON.stringify(data.id, null, 2)}
      </pre>
    </div>
  `;
}

function resetUIBlock(target) {
  target.innerHTML = "<div style='padding:8px; border:1px solid #444;'>RESET</div>";
}

// einmalige Sortier‑Darstellung aller Modi
